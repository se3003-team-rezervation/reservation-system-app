# DormDine – Environment Variables
# Copy this file to .env.local and fill in the values

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database: PostgreSQL Storage (Milestone 3) ───────────────────────────────
# Connection URI for PostgreSQL database (default: postgresql://localhost:5432/dormdine)
DATABASE_URL=postgresql://localhost:5432/dormdine
# Storage driver: "postgres" (recommended for M3), "file" (JSON fallback), or "memory"
DORMDINE_STORAGE=postgres

# ─── Fallback Persistent JSON storage (lib/store.ts) ─────────────────────────
# Path of the fallback JSON data file (used when DORMDINE_STORAGE=file)
# DORMDINE_DATA_FILE=.data/dormdine.json

# ─── Optional: Daily slot reset time (24h format, default: 00:00) ─────────────
# SLOT_RESET_HOUR=0

# ─── Authentication (Role-based: Staff PIN) ──────────────────────────────────
# Staff PIN required to access the Staff Panel and Slot Management (default: 1234)
# STAFF_PIN=1234
