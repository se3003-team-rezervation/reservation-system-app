# DormDine – Environment Variables
# Copy this file to .env.local and fill in the values

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Persistent storage (lib/store.ts) ───────────────────────────────────────
# Path of the JSON data file (default: .data/dormdine.json)
# DORMDINE_DATA_FILE=.data/dormdine.json
# Set to "memory" to disable disk persistence (used by tests)
# DORMDINE_STORAGE=file

# ─── Optional: Daily slot reset time (24h format, default: 00:00) ─────────────
# SLOT_RESET_HOUR=0

# ─── Optional: Max reservations per student per day (default: 3) ──────────────
# MAX_RESERVATIONS_PER_DAY=3
